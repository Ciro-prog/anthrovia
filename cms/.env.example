PAYLOAD_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# URL pública del CMS (VPS). Debe coincidir con cómo abrís el admin en el browser.
# Se usa en runtime Y en el Docker build (NEXT_PUBLIC_* se bakea en el JS).
# Tras cambiarla: docker compose -f docker-compose.prod.yml up -d --build
PAYLOAD_PUBLIC_SERVER_URL=http://pampaservers.com:60518
NEXT_PUBLIC_SERVER_URL=http://pampaservers.com:60518

# CORS / front Vercel (prod: tu dominio) — incluye localhost para live preview local
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://anthroviahr.com

# URL de la SPA para Live Preview y "Ver en el sitio"
PREVIEW_URL=https://anthroviahr.com
NEXT_PUBLIC_PREVIEW_URL=https://anthroviahr.com
# FRONTEND_URL=https://anthroviahr.com

# Primer admin (solo seed)
SEED_ADMIN_EMAIL=admin@anthroviahr.com
SEED_ADMIN_PASSWORD=AnthroviaAdmin2026!

# Database (dev local con compose.yml → puerto 5433)
DATABASE_URI=postgresql://anthrovia:anthrovia@localhost:5433/anthrovia_cms

# Solo prod compose (opcional)
# POSTGRES_PASSWORD=anthrovia
